(ns server
  (:require
    [com.stuartsierra.component :as component]
    [com.walmartlabs.lacinia.pedestal3 :as lp]
    [com.walmartlabs.lacinia.pedestal :refer [inject]]
    [io.pedestal.connector :as conn]
    [io.pedestal.http.jetty :as jetty]
    [io.pedestal.interceptor :refer [interceptor]]))

(defn ^:private extract-user-info
  [request]
  ;; This is very application-specific ...
  )

(def ^:private user-info-interceptor
  (interceptor
   {:name ::user-info
    :enter (fn [context]
              (let [{:keys [request]} context
                    user-info (extract-user-info request)]
                (assoc-in context [:request :lacinia-app-context :user-info] user-info)))}))

(defn ^:private interceptors
  [schema]
  (-> (lp/default-interceptors schema nil)
      (inject user-info-interceptor :after ::lp/inject-app-context)))

(defn ^:private create-connector
  [compiled-schema port]
  (let [interceptors (interceptors compiled-schema)
        routes #{["/api" :post interceptors :route-name ::api]}]
    (-> (conn/default-connector-map port)
        (conn/with-routes routes
          (lp/subscription-routes compiled-schema))
        (jetty/create-connector nil)
        conn/start!)))

(defrecord Server [schema-source connector port]

  component/Lifecycle

  (start [this]
    (let [compiled-schema (:schema schema-source)
          connector' (create-connector compiled-schema port)]
      (assoc this :connector connector')))

  (stop [this]
    (conn/stop! connector)
    (assoc this :connector nil)))
