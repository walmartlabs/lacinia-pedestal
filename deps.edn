{:deps          {org.clojure/clojure          {:mvn/version "1.12.5"}
                 com.walmartlabs/lacinia      {:mvn/version "1.3.0"}
                 io.pedestal/pedestal.service {:mvn/version "0.8.2-beta-8"}
                 better-cond/better-cond      {:mvn/version "2.1.5"}
                 com.rpl/proxy-plus           {:mvn/version "0.0.11"}}
 :mvn/repos     {"redplanetlabs" {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases"}}
 :paths         ["src" "resources"]
 :aliases
 {
  ;; clj -X:test
  :test
  {:extra-paths ["test" "dev-resources"

                 ;; Run clj -T:build prep to download sources from npm and move
                 ;; them to target/classes.  Unfortunate manual step.

                 "target/classes"]

   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                 io.pedestal/pedestal.jetty     {:mvn/version "0.8.2-beta-8"}
                 io.github.hlship/trace         {:mvn/version "1.4"}
                 org.clj-commons/pretty         {:mvn/version "3.8.0"}
                 io.github.tonsky/clj-reload    {:mvn/version "1.0.0"}
                 clj-http/clj-http              {:mvn/version "3.13.1"}
                 com.walmartlabs/test-reporting {:mvn/version "1.2"}
                 com.stuartsierra/component     {:mvn/version "1.2.0"}
                 expound/expound                {:mvn/version "0.9.0"}
                 hato/hato                      {:mvn/version "1.0.0"}
                 nubank/matcher-combinators     {:mvn/version "3.10.0"}
                 ch.qos.logback/logback-classic {:mvn/version "1.5.34"}}
   :jvm-opts    ["-Xmx500m"]
   :exec-fn     cognitect.test-runner.api/test}

  ;; clj -T:build <command>
  :build {:deps       {io.github.hlship/build-tools {:git/tag "0.12.1" :git/sha "05f3aeb"}
                       org.clj-commons/pretty       {:mvn/version "3.8.0"}
                       clj-kondo/clj-kondo          {:mvn/version "2026.04.15"}}
          :ns-default build}}

 :net.lewisship.build/scm
 {:url     "https://github.com/walmartlabs/lacinia-pedestal"
  :license :asl}

 :codox/config
 {:description "Expose Lacinia GraphQL as Pedestal endpoints"
  :source-uri  "https://github.com/walmartlabs/lacinia-pedestal/blob/master/{filepath}#L{line}"}}
